# VPS: значения задаются только в локальном .env
OPSBRIEF_UPLOAD_TOKEN=REPLACE_WITH_RANDOM_SECRET
OPSBRIEF_WEBHOOK_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
OPSBRIEF_ALICE_SKILL_ID=REPLACE_WITH_SKILL_ID
